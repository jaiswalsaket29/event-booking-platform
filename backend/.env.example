# Copy to .env (gitignored) and fill in real values.
# HS256 needs at least 32 bytes.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRY_MS=900000

# Base URL of frontend-user, used for links in verification/reset emails.
FRONTEND_USER_URL=http://localhost:5173

# Comma-separated CORS allowlist (the two frontends).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional Google login: also add google-oauth to SPRING_PROFILES_ACTIVE.
# SPRING_PROFILES_ACTIVE=google-oauth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Seed the demo catalog on startup if there are no events yet (true/false).
SEED_DEMO_DATA=true

# Redis (booking holds). docker-compose exposes it on localhost:6379 with no password.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# How long a checkout holds tickets before releasing them (Spring duration, e.g. 10m).
BOOKING_HOLD_TTL=10m

# Payments (simulated gateway). Secret used to sign/verify webhooks.
PAYMENT_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret
# WEBHOOK (outcome via signed webhook after a short delay) or SYNC (immediate).
PAYMENT_SIMULATED_MODE=WEBHOOK
