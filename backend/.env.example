# Copy to .env (gitignored) and fill in real values.
# HS256 needs at least 32 bytes.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRY_MS=900000

# Base URL of frontend-user, used for links in verification/reset emails.
FRONTEND_USER_URL=http://localhost:5173

# Comma-separated CORS allowlist (the two frontends).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional Google login: also add google-oauth to SPRING_PROFILES_ACTIVE.
# SPRING_PROFILES_ACTIVE=google-oauth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Seed the demo catalog on startup if there are no events yet (true/false).
SEED_DEMO_DATA=true

# Redis (booking holds). docker-compose exposes it on localhost:6379 with no password.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# How long a checkout holds tickets before releasing them (Spring duration, e.g. 10m).
BOOKING_HOLD_TTL=10m

# Payments (simulated gateway). Secret used to sign/verify webhooks.
PAYMENT_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret
# WEBHOOK (outcome via signed webhook after a short delay) or SYNC (immediate).
PAYMENT_SIMULATED_MODE=WEBHOOK

# Rate limits on login, forgot-password and booking creation (true/false).
RATE_LIMIT_ENABLED=true

# Optional: direct image uploads to Cloudflare R2 (pre-signed URLs). Leave empty to add images by URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL objects are served from, e.g. https://pub-xxxx.r2.dev or https://img.example.com
R2_PUBLIC_BASE_URL=

# OpenAPI spec + Swagger UI at /swagger-ui.html (true in dev, false in production).
API_DOCS_ENABLED=true

# ---- Production only (SPRING_PROFILES_ACTIVE=prod, see application-prod.yml) ----
# In prod the datasource and Redis come from these instead of the localhost defaults.
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_NAME=eventbooking
# DB_USER=eventbooking
# DB_PASSWORD=change-me
# DB_URL_PARAMS=?sslmode=require
# REDIS_URL=rediss://default:password@your-redis-host:6379
# Replaces the seeded admin's dev password at startup (min 12 chars). Required in prod.
# ADMIN_PASSWORD=change-me-to-a-long-admin-password
# Managed Redis usually forbids CONFIG SET (the sweeper covers expiry without it).
# REDIS_CONFIGURE_KEYSPACE_NOTIFICATIONS=false
